{
  "name": "Eden AI Hub",
  "short_name": "Eden Hub",
  "description": "Your AI team for making and selling games and digital products.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Projects", "url": "/?tab=projects", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Nexus", "url": "/?tab=nexus", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chat", "url": "/?tab=chat", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
