{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "start": "tsx server.ts",
    "build": "node scripts/build-dashboard.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "ci": "npm ci && npm run lint && npm test && npm run build",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:updates": "node --import tsx --test test/updateOverlap.test.ts test/grok.test.ts test/unrealUpdate.test.ts test/runners.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
